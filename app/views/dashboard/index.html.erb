    <div class="code-block"># Controller (Rails 8.1):
def show
  @project = Project.find(params[:id])
  respond_to do |format|
    format.html
    format.md { render markdown: @project }
  end
end

# Model must implement #to_markdown:
def to_markdown
  "# #{title}\n\n#{notes}"
end

# Access at: GET /projects/1.md</div>

    <% if Project.first %>
      <p style="margin-top:10px;">
        <%= link_to "Try it → View project as .md", project_path(Project.first, format: :md),
              style: "background:#7c3aed; color:white; padding:6px 14px; border-radius:6px; text-decoration:none; font-size:0.85em;" %>
      </p>
    <% else %>
      <p style="margin-top:10px; font-size:0.85em; color:#64748b;">
        Create a project first, then visit <code>/projects/:id.md</code>
      </p>
    <% end %>
  </div>

  <%# =========================================================================
      14. RAILS 8.1 — DEPRECATED ASSOCIATIONS
      ========================================================================= %>
  <div class="card">
    <h3>⚠️ Deprecated Associations <span class="badge badge-purple">✨ Rails 8.1</span></h3>
    <p class="subtitle">Mark associations as deprecated — get warnings, raise errors, or emit events</p>

    <div class="stat-row">
      <span class="stat-label">Tasks in DB</span>
      <span class="stat-value"><%= @tasks_count %></span>
    </div>
    <div class="stat-row">
      <span class="stat-label">Association</span>
      <span class="stat-value">User has_many :tasks</span>
    </div>
    <div class="stat-row">
      <span class="stat-label">Mode</span>
      <span class="stat-value">deprecated: :notify</span>
    </div>
    <div class="stat-row">
      <span class="stat-label">Available modes</span>
      <span class="stat-value">:warn, :raise, :notify</span>
    </div>
    <div class="stat-row">
      <span class="stat-label">Triggers on</span>
      <span class="stat-value" style="font-size:0.8em;">user.tasks, preload(:tasks), includes...</span>
    </div>

    <div class="code-block"># Rails 8.1: mark association as deprecated
class User < ApplicationRecord
  has_many :tasks, deprecated: :notify
  # modes: true/:warn → logs warning
  #        :raise     → raises error
  #        :notify    → emits Rails.event
end

# Any access triggers the deprecation:
user.tasks          # → emits event
user.tasks = [...]  # → emits event
User.includes(:tasks) # → emits event

# See /events for the emitted notifications</div>

    <p style="margin-top:10px; font-size:0.82em; color:#475569;">
      Models where tasks are being migrated to a separate service
      can be phased out gradually using this feature.
      <%= link_to "View Events →", events_path, style: "color:#7c3aed;" %>
    </p>
  </div>

</div>

<div style="margin-top:30px; padding:16px; background:#f8fafc; border-radius:8px; font-size:0.85em; color:#475569;">
  <strong>📋 Rails 8 + Rails 8.1 "SQLite for Everything" Philosophy:</strong>
  No Redis, no Memcached, no separate queue server needed.
  Solid Queue (queue.sqlite3) + Solid Cache (cache.sqlite3) + Solid Cable (cable.sqlite3)
  give you a full production stack with zero external services.
  <br><br>
  <strong>✨ New in Rails 8.1:</strong>
  Active Job Continuations (resumable jobs) ·
  Structured Event Reporting (Rails.event.notify) ·
  Markdown Rendering (format.md) ·
  Deprecated Associations (has_many deprecated: :notify)
</div>
