    <div class="code-block"># Emit from anywhere in Rails 8.1:
Rails.event.notify(
  "project.created",
  project_id: 42, title: "My Project"
)

# Subscriber receives it:
class LogEventSubscriber
  def emit(event)
    event[:name]            # "project.created"
    event[:payload]         # { project_id: 42, ... }
    event[:source_location] # { filepath:, lineno: }
    event[:occurred_at]     # Time
  end
end

# Register in initializer:
Rails.event.subscribe(LogEventSubscriber.new)</div>

    <p style="margin-top:10px;">
