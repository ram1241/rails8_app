    </div>
    <div class="stat-row">
      <span class="stat-label">Completed</span>
      <span class="stat-value" style="color:#166534;"><%= @import_stats[:completed] %></span>
    </div>
    <div class="stat-row">
      <span class="stat-label">Failed</span>
