    </div>
    <div class="stat-row">
      <span class="stat-label">Job class</span>
      <span class="stat-value">ProcessImportJob</span>
    </div>

    <div class="code-block">class ProcessImportJob < ApplicationJob
  include ActiveJob::Continuable  # ✨ Rails 8.1

  def perform(import_id)
    @import = Import.find(import_id)

    step :validate do          # Step 1 (block format)
      @import.update!(status: "processing")
    end

    step :process_records do |step|  # Step 2 + cursor
      @import.records.find_each(start: step.cursor) do |r|
        r.process
        step.advance!(from: r.id)   # saves cursor
      end
    end

    step :finalize             # Step 3 (method ref)
  end
end</div>

    <p style="margin-top:10px;">
      <%= link_to "Try it → Start an Import", new_import_path,
